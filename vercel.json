{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "cdg1"
  ],
  "installCommand": "npm ci --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "includeFiles": "backend/studoo/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/cours",
      "destination": "/"
    },
    {
      "source": "/cours/:path*",
      "destination": "/"
    },
    {
      "source": "/fichier",
      "destination": "/"
    },
    {
      "source": "/fichier/:path*",
      "destination": "/"
    },
    {
      "source": "/enregistrer",
      "destination": "/"
    },
    {
      "source": "/enregistrer/:path*",
      "destination": "/"
    },
    {
      "source": "/numeriser",
      "destination": "/"
    },
    {
      "source": "/numeriser/:path*",
      "destination": "/"
    },
    {
      "source": "/importer",
      "destination": "/"
    },
    {
      "source": "/importer/:path*",
      "destination": "/"
    },
    {
      "source": "/confirmer",
      "destination": "/"
    },
    {
      "source": "/confirmer/:path*",
      "destination": "/"
    },
    {
      "source": "/creer",
      "destination": "/"
    },
    {
      "source": "/creer/:path*",
      "destination": "/"
    },
    {
      "source": "/emploi-du-temps",
      "destination": "/"
    },
    {
      "source": "/emploi-du-temps/:path*",
      "destination": "/"
    },
    {
      "source": "/generations",
      "destination": "/"
    },
    {
      "source": "/reglages",
      "destination": "/"
    },
    {
      "source": "/reglages/:path*",
      "destination": "/"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/:path*",
      "destination": "/"
    },
    {
      "source": "/analytics",
      "destination": "/"
    },
    {
      "source": "/analytics/:path*",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(self), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://*.googleusercontent.com; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://www.googleapis.com https://accounts.google.com/gsi/; frame-src 'self' blob: https://accounts.google.com/gsi/; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/((?!assets/|api/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
