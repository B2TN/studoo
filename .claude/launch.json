{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "studoo.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8000",
        "--reload",
        "--reload-dir",
        "backend"
      ],
      "port": 8000
    },
    {
      "name": "api-demo",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "studoo.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8000"
      ],
      "env": {
        "DEV_LOGIN": "1",
        "AI_FAKE": "1",
        "GOOGLE_CLIENT_ID": "",
        "DATABASE_URL": "sqlite:///studoo-demo.db",
        "WORKER_QUEUE_URL": "",
        "ADMIN_EMAILS": "dev@studoo.localhost"
      },
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "maquette",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5510",
        "--bind",
        "127.0.0.1"
      ],
      "port": 5510
    }
  ]
}