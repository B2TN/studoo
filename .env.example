# Copie ce fichier en .env et remplis les valeurs (ne jamais committer .env !)
APP_URL=http://localhost:5173

# Google Cloud > API et services > Identifiants > ID client OAuth (application Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google AI Studio > Get API key
GEMINI_API_KEY=
# Modèles (à vérifier dans AI Studio, les noms évoluent)
GEMINI_MODEL_LITE=gemini-flash-lite-latest
GEMINI_MODEL_FLASH=gemini-flash-latest
GEMINI_MODEL_TTS=gemini-2.5-flash-preview-tts

# Au moins 32 caractères aléatoires : python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Ton (tes) e-mail(s) Google pour accéder à /admin et /analytics
ADMIN_EMAILS=

# Local : SQLite ; production : URL Postgres Neon
DATABASE_URL=sqlite:///./studoo-dev.db

# Quotas quotidiens (niveau gratuit Gemini)
QUOTA_LITE_PER_DAY=450
QUOTA_FLASH_PER_DAY=18
QUOTA_TTS_PER_DAY=12
QUOTA_USER_PER_DAY=60

# Développement local uniquement (ignorés hors localhost)
DEV_LOGIN=1
AI_FAKE=0

# Serveur de tâches (Modal) : adresse « kick » affichée par « modal deploy worker/modal_app.py »
WORKER_KICK_URL=
