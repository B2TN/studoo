# Copie ce fichier en .env et remplis les valeurs (ne jamais committer .env !)
APP_URL=http://localhost:5173

# Google Cloud > API et services > Identifiants > ID client OAuth (application Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# IA du site : Azure OpenAI (portail Azure > ressource OpenAI > Clés et point de terminaison)
AZURE_OPENAI_KEY=
# https://<ressource>.openai.azure.com/openai/v1/chat/completions
AZURE_OPENAI_URL=
AZURE_OPENAI_MODEL=gpt-4.1-mini
# Transcription : Azure AI Speech (ressource Speech > Clés)
SPEECH_KEY=
SPEECH_REGION=italynorth
# Gemini : AUCUNE clé du site. Seuls les élèves peuvent ajouter la leur (Réglages). Modèle utilisé avec leur clé :
GEMINI_MODEL_FLASH=gemini-flash-latest

# Au moins 32 caractères aléatoires : python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Ton (tes) e-mail(s) Google pour accéder à /admin et /analytics
ADMIN_EMAILS=

# Local : SQLite ; production : URL Postgres Neon
DATABASE_URL=sqlite:///./studoo-dev.db

# Quotas quotidiens de l'IA du site (pour tenir dans le crédit Azure)
QUOTA_LITE_PER_DAY=2000
QUOTA_FLASH_PER_DAY=300
# Générations du serveur de tâches : par élève et par jour, et plafond global du site
QUOTA_JOBS_PER_DAY=10
QUOTA_SITE_JOBS_PER_DAY=150
QUOTA_USER_PER_DAY=60

# Développement local uniquement (ignorés hors localhost)
DEV_LOGIN=1
AI_FAKE=0

# Serveur de tâches (Azure) : adresse affichée par worker/azure/deploy.ps1 (file + jeton d'ajout seul)
WORKER_QUEUE_URL=
# Côté serveur de tâches (.env.worker, pas Vercel) : rien à ajouter pour l'écriture des scripts (Azure OpenAI est posé par worker/azure/deploy.ps1) ; GROQ_API_KEY=gsk_… reste possible en plus

# Suivi des erreurs (Sentry, facultatif) : DSN du projet ; vide = désactivé
SENTRY_DSN=
# 1 seulement quand l'e-mail de secours (Brevo) est vraiment configuré sur le serveur de tâches
EMAIL_NOTIFICATIONS=0
